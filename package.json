{
  "name": "agentic-reply",
  "version": "0.1.0",
  "description": "Preview and send approved comment replies to GitHub, Slack, Discord, YouTube, Reddit, Mastodon, and webhooks with a TypeScript SDK, CLI, and MCP.",
  "keywords": [
    "comment-replies",
    "approval-queue",
    "github",
    "slack",
    "discord",
    "youtube",
    "reddit",
    "mastodon",
    "webhook",
    "typescript",
    "cli",
    "mcp",
    "auto-reply",
    "regex"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-reply.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-reply",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-reply": "./dist/cli.js",
    "agentic-reply-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-core": "0.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
